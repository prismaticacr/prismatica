---
// src/layouts/LayoutLegal.astro
import HeaderLegal from "@/components/sections/HeaderLegal.astro";
import "../styles/global.css";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} | toDeploy Software & Automation</title>
    <meta name="description" content={description} />
  </head>
  <body class="text-gray-900 antialiased" style="background-color: #f8f9fb !important; color: #111827 !important;">
    <HeaderLegal />
    <slot />
  </body>
</html>

<style is:global>
  body.legal-page {
    background-color: #f8f9fb !important;
    color: #111827 !important;
  }
</style>