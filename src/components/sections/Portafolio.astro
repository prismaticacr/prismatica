---
// PortfolioSection.astro
import ameliaWebsite from "@/assets/img/amelia-website.jpg";
import luisWebsite from "@/assets/img/larqcr-website.jpg"; // tu segunda web
import chatbot1 from "@/assets/img/chatbot1.jpg";   // fotos del chatbot
import chatbot2 from "@/assets/img/chatbot2.jpg";
import chatbot3 from "@/assets/img/chatbot3.jpg";
import chatbot4 from "@/assets/img/chatbot4.jpg";
import Background from "@/components/sections/Background.astro";

const categories = [
  {
    id: "web",
    label: "Páginas Web",
    projects: [
      {
        title: "Sitio web profesional para psicología clínica.",
        category: "Diseño y desarrollo de sitios web profesionales",
        description:
          "Sitio web diseñado y desarrollado para la psicóloga Amelia Reyes, enfocado en transmitir cercanía, confianza y profesionalismo. La plataforma presenta sus servicios en salud mental materna, bienestar emocional femenino y terapia de pareja, con una estructura clara, diseño cálido y una experiencia de usuario pensada para acompañar y orientar a cada paciente desde el primer contacto.",
        image: ameliaWebsite,
        tags: ["Astro", "Tailwind", "TypeScript", "Website"],
        link: "https://psicologaameliareyes.com/",
        gallery: [],
      },
      {
        title: "Sitio web profesional para agencia de arquitectos",
        category: "Diseño y desarrollo de sitios web profesionales",
        description: "Sitio web diseñado y desarrollado para LARQ Arquitectura, un estudio costarricense con más de 6 años creando espacios residenciales, comerciales e institucionales. La plataforma presenta su portafolio de proyectos, servicios y filosofía de diseño con una estética limpia y contemporánea que refleja la identidad visual del estudio.",
        image: luisWebsite,
        tags: ["Astro", "Tailwind", "TypeScript", "Website"],
        link: "https://larqcr.com/",
        gallery: [],
      },
    ],
  },
  {
    id: "chatbots",
    label: "Chatbots",
    projects: [
      {
        title: "Desarrollado para una empresa de facturación con más de 3000 clientes.",
        category: "Chatbots y automatizaciones",
        description: "Asistente inteligente por WhatsApp que atiende clientes de forma autónoma las 24 horas. Procesa cualquier tipo de mensaje — texto, audios, imágenes y documentos — y responde con el contexto completo de la conversación, sin que el cliente tenga que repetir información. Cubre múltiples departamentos desde un solo canal: software, ventas, soporte técnico, marketing, pagos y escalamiento a un agente humano cuando la situación lo requiere. Cada consulta se clasifica y etiqueta automáticamente según su categoría, y agenda citas sin intervención humana. Toda la actividad queda guardada en una base de datos propia, permitiendo analizar qué preguntan más los clientes y mejorar el servicio de forma continua.",
        image: chatbot1,
        tags: ["n8n", "Chatwoot", "WhatsApp", "PostgreSQL", "Chatbot"],
        link: "",
        gallery: [chatbot1, chatbot2, chatbot3, chatbot4],
      },
    ],
  },
];
---

<section id="portfolio" class="border-b-0 relative py-16 sm:py-20 md:py-24 lg:py-32 overflow-hidden">
  <Background />
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-12 sm:mb-14 md:mb-16 section-header">
      <span class="text-[#3B82F6] font-medium text-xs sm:text-sm uppercase tracking-wider">
        NUESTRO TRABAJO
      </span>
      <h2 class="font-heading text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-bold mt-2 sm:mt-3 mb-4 sm:mb-6 text-white px-4 sm:px-0">
        Portfolio de <span class="text-[#3B82F6] block xs:inline mt-1 xs:mt-0">Proyectos</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-base sm:text-lg px-4 sm:px-6 lg:px-0 leading-relaxed">
        Descubre algunos de los proyectos que hemos desarrollado para nuestros clientes.
      </p>
    </div>

    <!-- Category tabs -->
    <div class="flex justify-center mb-10 sm:mb-12">
      <div class="flex gap-2 p-1 bg-white/5 border border-white/10 rounded-xl">
        {categories.map((cat, i) => (
          <button
            class={`category-tab px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-300 ${
              i === 0
                ? "bg-[#3B82F6] text-white shadow-lg shadow-[#3B82F6]/30"
                : "text-gray-400 hover:text-white"
            }`}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Category panels -->
    {categories.map((cat, catIndex) => (
      <div
        class="category-panel"
        data-panel={cat.id}
        style={catIndex !== 0 ? "display: none;" : ""}
      >
        {cat.projects.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16 md:mb-20">
            {cat.projects.map((project, index) => (
              <div
                class="group project-card relative z-10"
                style={`animation-delay: ${index * 0.1}s`}
              >
                <div class="relative project-card-inner bg-[white]/3 backdrop-blur-xl border border-white/10 rounded-xl sm:rounded-2xl overflow-hidden transition-all duration-400 hover:shadow-[0_20px_40px_rgba(59,130,246,0.15)]">
                  <div class="absolute inset-0 rounded-xl sm:rounded-2xl border-2 border-transparent group-hover:border-[#3B82F6]/80 transition-all duration-500 glow-border pointer-events-none" />

                  <div class="relative z-10">
                    <!-- Image -->
                    <div class="relative h-48 sm:h-56 md:h-64 overflow-hidden">
                      <img
                        src={project.image.src}
                        alt={project.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      />
                      <div class="absolute inset-0 bg-linear-to-t from-[#0a0b1a] via-[#0a0b1a]/60 to-transparent" />

                      <!-- Overlay botón hover (desktop) -->
                      <div class="hidden sm:flex absolute inset-0 items-center justify-center bg-[#0a0b1a]/80 opacity-0 group-hover:opacity-100 transition-all duration-500">
                        {project.gallery.length > 0 ? (
                          <button
                            class="open-gallery bg-[#FF6D00] hover:bg-[#FF6D00]/90 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg inline-flex items-center text-xs sm:text-sm font-bold transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-lg"
                            data-images={JSON.stringify(project.gallery.map((img) => img.src))}
                            data-title={project.title}
                          >
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Ver Fotos
                          </button>
                        ) : (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="bg-[#FF6D00] hover:bg-[#FF6D00]/90 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg inline-flex items-center text-xs sm:text-sm font-bold transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-lg"
                          >
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            Ver Proyecto
                          </a>
                        )}
                      </div>
                    </div>

                    <!-- Content -->
                    <div class="p-4 sm:p-5 md:p-6">
                      <span class="text-[#3B82F6] text-xs sm:text-sm font-medium">
                        {project.category}
                      </span>
                      <h3 class="font-heading text-lg sm:text-xl font-semibold mt-2 mb-2 sm:mb-3 text-white">
                        {project.title}
                      </h3>
                      <p class="text-gray-400 text-sm leading-relaxed mb-3 sm:mb-4">
                        {project.description}
                      </p>
                      <div class="flex flex-wrap gap-1.5 sm:gap-2">
                        {project.tags.map((tag) => (
                          <span class="px-2 sm:px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] sm:text-xs font-medium text-gray-400">
                            {tag}
                          </span>
                        ))}
                      </div>

                      <!-- Mobile CTA -->
                      <div class="sm:hidden mt-4">
                        {project.gallery.length > 0 ? (
                          <button
                            class="open-gallery w-full bg-[#3B82F6] hover:bg-[#3B82F6]/90 text-white px-4 py-2.5 rounded-lg inline-flex items-center justify-center text-sm font-bold transition-all duration-300 shadow-lg active:scale-95"
                            data-images={JSON.stringify(project.gallery.map((img) => img.src))}
                            data-title={project.title}
                          >
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Ver Fotos
                          </button>
                        ) : (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full bg-[#3B82F6] hover:bg-[#3B82F6]/90 text-white px-4 py-2.5 rounded-lg inline-flex items-center justify-center text-sm font-bold transition-all duration-300 shadow-lg active:scale-95"
                          >
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            Ver Proyecto
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="flex flex-col items-center justify-center py-20 sm:py-28 text-center">
            <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mb-5">
              <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <p class="text-gray-500 text-base font-medium">Próximamente</p>
            <p class="text-gray-600 text-sm mt-1">Estamos trabajando en nuevos proyectos.</p>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <div class="relative w-full max-w-4xl mx-auto px-4 flex flex-col items-center gap-4">

    <!-- Cerrar -->
    <button
      id="lightbox-close"
      class="absolute -top-10 right-4 text-white/60 hover:text-white transition-colors"
      aria-label="Cerrar"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Imagen principal -->
    <div class="relative w-full flex items-center justify-center">
      <button
        id="lightbox-prev"
        class="absolute left-0 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-all"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[70vh] max-w-full rounded-xl object-contain"
      />

      <button
        id="lightbox-next"
        class="absolute right-0 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-all"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Miniaturas -->
    <div id="lightbox-thumbs" class="flex gap-2 overflow-x-auto max-w-full pb-1">
    </div>

    <!-- Contador -->
    <p id="lightbox-counter" class="text-white/40 text-xs"></p>
  </div>
</div>

<script>
  // ── Tabs ──────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>(".category-tab");
  const panels = document.querySelectorAll<HTMLElement>(".category-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.category;
      tabs.forEach((t) => {
        t.classList.remove("bg-[#3B82F6]", "text-white", "shadow-lg", "shadow-[#3B82F6]/30");
        t.classList.add("text-gray-400");
      });
      tab.classList.add("bg-[#3B82F6]", "text-white", "shadow-lg", "shadow-[#3B82F6]/30");
      tab.classList.remove("text-gray-400");
      panels.forEach((panel) => {
        panel.style.display = panel.dataset.panel === target ? "" : "none";
      });
    });
  });

  // ── Lightbox ──────────────────────────────────────────
  const lightbox   = document.getElementById("lightbox")!;
  const lbImg      = document.getElementById("lightbox-img") as HTMLImageElement;
  const lbThumbs   = document.getElementById("lightbox-thumbs")!;
  const lbCounter  = document.getElementById("lightbox-counter")!;
  const lbClose    = document.getElementById("lightbox-close")!;
  const lbPrev     = document.getElementById("lightbox-prev")!;
  const lbNext     = document.getElementById("lightbox-next")!;

  let images: string[] = [];
  let current = 0;

  function showImage(index: number) {
    current = (index + images.length) % images.length;
    lbImg.src = images[current];
    lbCounter.textContent = `${current + 1} / ${images.length}`;

    // Resaltar miniatura activa
    lbThumbs.querySelectorAll("img").forEach((t, i) => {
      t.classList.toggle("ring-2", i === current);
      t.classList.toggle("ring-[#3B82F6]", i === current);
      t.classList.toggle("opacity-100", i === current);
      t.classList.toggle("opacity-40", i !== current);
    });
  }

  function openLightbox(imgs: string[], startIndex = 0) {
    images = imgs;

    // Construir miniaturas
    lbThumbs.innerHTML = "";
    imgs.forEach((src, i) => {
      const thumb = document.createElement("img");
      thumb.src = src;
      thumb.alt = "";
      thumb.className = "h-14 w-20 object-cover rounded-lg cursor-pointer transition-all flex-shrink-0";
      thumb.addEventListener("click", () => showImage(i));
      lbThumbs.appendChild(thumb);
    });

    showImage(startIndex);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  lbClose.addEventListener("click", closeLightbox);
  lbPrev.addEventListener("click", () => showImage(current - 1));
  lbNext.addEventListener("click", () => showImage(current + 1));

  // Cerrar al hacer clic en el fondo
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Navegación con teclado
  document.addEventListener("keydown", (e) => {
    if (lightbox.classList.contains("hidden")) return;
    if (e.key === "ArrowRight") showImage(current + 1);
    if (e.key === "ArrowLeft")  showImage(current - 1);
    if (e.key === "Escape")     closeLightbox();
  });

  // Abrir desde los botones de galería
  document.querySelectorAll<HTMLButtonElement>(".open-gallery").forEach((btn) => {
    btn.addEventListener("click", () => {
      const imgs = JSON.parse(btn.dataset.images || "[]") as string[];
      openLightbox(imgs, 0);
    });
  });

  // ── Scroll animations ─────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add("animate-in"); }),
    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
  );

  const sectionHeader = document.querySelector(".section-header");
  if (sectionHeader) observer.observe(sectionHeader);
  document.querySelectorAll(".project-card").forEach((card) => observer.observe(card));
</script>

<style>
  .glow-border {
    box-shadow: 0 0 0px rgba(59, 130, 246, 0);
    transition: box-shadow 0.5s ease-in-out;
  }

  @media (min-width: 640px) {
    .group:hover .glow-border {
      box-shadow:
        0 0 20px rgba(59, 130, 246, 0.5),
        0 0 40px rgba(59, 130, 246, 0.3),
        inset 0 0 20px rgba(59, 130, 246, 0.1);
    }
    .group:hover .project-card-inner {
      transform: translateY(-5px);
    }
  }

  .project-card-inner { transform: translateY(0); }

  .section-header {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .section-header.animate-in { opacity: 1; transform: translateY(0); }

  .project-card {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .project-card.animate-in { opacity: 1; transform: translateY(0); }

  @media (hover: none) {
    .group:hover .glow-border { box-shadow: none; }
    .group:active .project-card-inner { transform: scale(0.98); }
  }

  @media (max-width: 640px) {
    .project-card { -webkit-tap-highlight-color: transparent; user-select: none; }
  }
</style>